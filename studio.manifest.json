  ],
  "decision_chain": {
    "final_stage": "final decision record",
    "stages": {
      "decision brief": {"minimum": 1, "maximum": 1},
      "research memo": {"minimum": 1},
      "proposal": {"minimum": 3},
      "critique": {"minimum": 3},
      "rebuttal": {"minimum": 3},
      "scorecard": {"minimum": 1},
      "red-team report": {"minimum": 1},
      "final decision record": {"minimum": 1, "maximum": 1}
    },
    "proposal_minimum_distinct_authors": 3,
    "red_team_author": "independent-red-team-auditor",
    "not_applicable_value": "NOT APPLICABLE",
    "approved_status": "APPROVED",
    "blocking_stop_gates": ["FAIL", "NOT REVIEWED"]
  },
  "repository_protection": {
    "founder_github_owner": "@adomm16",
    "require_global_owner_rule": true,
    "require_explicit_critical_patterns": true,
    "critical_codeowners_patterns": [
      "/AGENTS.md",
      "/studio.manifest.json",
      "/docs/studio/",
      "/docs/agents/",
      "/docs/decisions/approved/",
      "/docs/audits/",
      "/.github/",
      "/scripts/validate_studio.py",
      "/tests/"
    ],
    "required_workflow_file": ".github/workflows/studio-validation.yml",
    "required_workflow_name": "studio-validation",
    "required_job_id": "validate",
    "required_job_display_name": "studio-validation",
    "required_status_check": "studio-validation",
    "required_triggers": ["pull_request", "push"],
    "required_push_branches": ["chatgb", "fix/**"],
    "required_commands": [
      "python scripts/validate_studio.py",
      "python -m unittest discover -s tests -v"
    ],
    "required_actions": ["actions/checkout@", "actions/setup-python@"],
    "forbidden_failure_masking_patterns": [
      "\\|\\|\\s*true\\s*$", ";\\s*true\\s*$", "&&\\s*exit\\s+0\\s*$"
    ],
    "supported_yaml_subset": [
      "indentation-based block mappings",
      "indentation-based block sequences",
      "plain and quoted scalar values",
      "single-line name, uses, and run values"
    ]
  },
  "agent_profile_regression": {
    "allowed_shared_sections": ["Yetkileri"],
    "warn_when_identical_across_all_profiles": true
  }
}
